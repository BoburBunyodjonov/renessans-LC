# ---------- database ----------
# Host port for the Postgres container; change if 5433 is taken locally.
DB_PORT=5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school?schema=public"

# ---------- auth ----------
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=""                      # openssl rand -base64 32
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- storage (choose one driver) ----------
STORAGE_DRIVER="local"              # local | s3
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ---------- notifications ----------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_API_BASE=""            # optional; defaults to https://api.telegram.org
RESEND_API_KEY=""
NOTIFY_EMAIL=""

# ---------- rate limiting ----------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------- misc ----------
IP_SALT=""
REVALIDATE_SECRET=""
SEED_ADMIN_EMAIL="admin@school.uz"
SEED_ADMIN_PASSWORD="ChangeMe123!"
